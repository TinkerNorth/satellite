#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# Satellite pre-commit hook: formats the staged C/C++ and Objective-C++ files
# with the clang-format scripts/tools.sh pins (the one CI checks with) and
# re-stages them. CI runs the same formatter in check mode, so anything this
# hook misses still fails the pull request.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=()
while IFS= read -r -d '' file; do
    staged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.cpp' '*.h' '*.c' '*.mm')
if [ "${#staged[@]}" -eq 0 ]; then
    exit 0
fi

# shellcheck source=scripts/tools.sh
source scripts/tools.sh
fetch_clang_format
echo "=== clang-format ${CLANG_FORMAT_VERSION} (staged files) ==="
clang-format -i "${staged[@]}"
git add -- "${staged[@]}"
